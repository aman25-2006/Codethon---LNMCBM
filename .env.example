# ==============================================================================
# COLLEGE CODING COMPETITION PORTAL - PRODUCTION ENVIRONMENT CONFIGURATION
# Lalit Narayan Mishra College of Business Management (LNMCBM), Muzaffarpur
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local` for local development.
# 2. In Vercel / Production deployment, set these variables in the Project Settings -> Environment Variables.
# 3. CRITICAL: NEVER commit `.env` or `.env.local` to Git. Keep private keys strictly confidential.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION BASE URL
# Canonical domain of the application. Used for generating student login links,
# auth redirects, email links, and securing HTTP-only session cookies.
# ------------------------------------------------------------------------------
# Local: http://localhost:3000
# Production: https://your-competition-subdomain.vercel.app or https://codethon.lnmcbm.ac.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTHENTICATION CONFIGURATION
# Obtain these credentials from your Supabase Dashboard: Project Settings -> API.
# ------------------------------------------------------------------------------
# [PUBLIC] REST API URL for Supabase (Safe for browser/client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [PUBLIC] Anonymous Client Key (Safe for browser/client bundle)
# Enforces Row Level Security (RLS) policies on all client queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# [CONFIDENTIAL - SERVER-SIDE ONLY]
# Service Role Secret Key (Bypasses RLS for secure server actions, scoring, and admin operations)
# CRITICAL: NEVER prefix with NEXT_PUBLIC_. NEVER expose to browser clients or frontend code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-placeholder

# ------------------------------------------------------------------------------
# 3. INITIAL ADMINISTRATOR (BOOTSTRAP CONTROLLER)
# Used to seed and authenticate the initial master exam controller before secondary
# administrators are created. Once logged in, change the password immediately.
# ------------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@lnmcbm.ac.in
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongMasterPassword2026!

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL DELIVERY (RESEND API)
# Dispatches candidate login credentials (Roll number + 8-char temporary password).
# When unset in development, the system logs dispatches to an internal simulated outbox.
# ------------------------------------------------------------------------------
# Resend API Key (Generate at https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_placeholder

# Verified Sender Address (Must match a verified domain or subdomain in Resend)
# Example: "LNMCBM Exam Controller <exams@yourdomain.edu>"
# Development default: "LNMCBM Exam Controller <onboarding@resend.dev>"
RESEND_FROM_EMAIL="LNMCBM Exam Controller <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 5. ISOLATED CODE EXECUTION SERVICE (MULTI-TIER ENGINE)
# Used for compiling and running C, C++, Java, Python, JavaScript, and DSA test cases.
# Supported runners:
# - Tier 1: Local isolated host compilers (zero network latency, offline)
# - Tier 2: Piston API v2 (Dockerized multi-compiler cloud runner)
# - Tier 3: Judge0 CE API (RapidAPI or self-hosted)
# ------------------------------------------------------------------------------
# Piston API endpoint (Default public instance or your private Docker instance)
PISTON_API_URL=https://emkc.org/api/v2/piston/execute

# Judge0 CE API endpoint and API key (Optional alternative)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-judge0-key-placeholder

# ------------------------------------------------------------------------------
# 6. COMPETITION PARTICIPANT IDENTIFIERS
# Prefix used when auto-assigning unique Participant IDs (e.g. LNMC-COD-001)
# ------------------------------------------------------------------------------
PARTICIPANT_ID_PREFIX=LNMC-COD
